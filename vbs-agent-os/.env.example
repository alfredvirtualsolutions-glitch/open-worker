# Copy to .env on the server and fill in real values. NEVER commit this file
# with real secrets, and never paste real values into a chat session (PRD §7).

# --- Custom domain served by Caddy (must already point at this server's IP) ---
DOMAIN=ops.warmail.online

# --- Managed Postgres (e.g. UpCloud Managed Database) ---
# Full connection string including sslmode=require, e.g.:
# postgres://USER:PASSWORD@HOST.db.upclouddatabases.com:PORT/DBNAME?sslmode=require
DATABASE_URL=

# --- Anthropic (powers all 5 agent roles: Hermes/Gemma/DeepSeek/Prime/Nova) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Admin API bearer token (used for every /tasks, /reports, /control call) ---
# Generate with: openssl rand -hex 32
HERMES_ADMIN_TOKEN=change-me-to-a-long-random-value

# --- Optional tuning ---
DISPATCH_INTERVAL_MS=3000
DISPATCH_CONCURRENCY=3
MODEL_HERMES=claude-sonnet-4-5
MODEL_GEMMA=claude-sonnet-4-5
MODEL_DEEPSEEK=claude-sonnet-4-5
MODEL_PRIME=claude-sonnet-4-5
MODEL_NOVA=claude-sonnet-4-5
